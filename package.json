{
  "name": "shugaba",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "tsx src/lib/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "eval:agents": "tsx scripts/eval-agents.ts",
    "record:golden": "tsx scripts/record-golden.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.107",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.156",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.28",
    "pg-boss": "10",
    "postgres": "^3.4.9",
    "react": "19",
    "react-dom": "19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9",
    "eslint-config-next": "15.5.28",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "^8.5.18"
    }
  }
}
